# ============================================
# .env.example - PLANTILLA PARA ROOT
# ============================================
# Copiar este archivo: cp .env.example .env
# El .env ya existe en tu proyecto, este es solo el template
# ============================================

# ============================================
# CONFIGURACIÓN DE RED - AUTOMÁTICA
# ============================================
DEPLOYMENT_MODE=auto

# ============================================
# PUERTOS PÚBLICOS
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS - PostgreSQL
# ============================================
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=medical_pass
POSTGRES_DB=medical_appointments

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS - MongoDB
# ============================================
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_pass
MONGO_DB=medical_records

# ============================================
# CONFIGURACIÓN DE SESIONES
# ============================================
SESSION_EXPIRE_MINUTES=60

# ============================================
# CONFIGURACIÓN DE CORS
# ============================================
CORS_ORIGINS=*
