# ===========================================
# BACKEND .env - COMPLEMENTA AL .env ROOT
# ===========================================
# Este archivo contiene variables ADICIONALES específicas del backend
# Las variables de bases de datos y red se leen del .env root
# ===========================================

# ===========================================
# BASES DE DATOS - URLs Completas
# ===========================================
# Estas se construyen usando las variables del .env root
# PostgreSQL
DATABASE_URL=postgresql://${POSTGRES_USER:-medical_user}:${POSTGRES_PASSWORD:-medical_pass}@postgres:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-medical_appointments}

# MongoDB
MONGODB_URL=mongodb://${MONGO_USER:-mongo_user}:${MONGO_PASSWORD:-mongo_pass}@mongodb:${MONGO_PORT:-27017}/
MONGODB_DB_NAME=${MONGO_DB:-medical_records}

# Redis
REDIS_URL=redis://redis:${REDIS_PORT:-6379}/0

# ===========================================
# SESIONES Y AUTENTICACIÓN
# ===========================================
# Usa la variable del .env root
SESSION_EXPIRE_MINUTES=${SESSION_EXPIRE_MINUTES:-60}

# Token de autenticación (generar uno random en producción)
SECRET_KEY=your-secret-key-change-in-production-please-make-it-very-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# NOTIFICACIONES - SendGrid (Email) - OPCIONAL
# ===========================================
# IMPORTANTE: Para habilitar notificaciones por email:
# 1. Crear cuenta en: https://signup.sendgrid.com/
# 2. Crear API Key en: Settings > API Keys
# 3. Reemplazar el valor a continuación
# 
# Si NO configuras SendGrid:
# - ✅ El sistema FUNCIONA normalmente
# - ✅ Service Registry funciona
# - ✅ Circuit Breaker funciona
# - ❌ No se envían emails (solo logs)

SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@medical-system.com
NOTIFICATION_EMAIL=admin@medical-system.com

# ===========================================
# NOTIFICACIONES - Twilio (SMS) - OPCIONAL
# ===========================================
# Solo si necesitas SMS (opcional)
# Dejar vacío si no usas Twilio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===========================================
# SERVICE REGISTRY - Configuración de Monitoreo
# ===========================================
# Estas son las nuevas variables para Service Registry

# Intervalo de health checks automáticos (en segundos)
HEALTH_CHECK_INTERVAL=30

# Intervalo de heartbeats (en segundos)
HEARTBEAT_INTERVAL=10

# Número de fallos consecutivos antes de marcar servicio como DOWN
FAILURE_THRESHOLD=3

# Timeout para health checks (en segundos)
HEALTH_CHECK_TIMEOUT=5

# ===========================================
# CIRCUIT BREAKER - Configuración
# ===========================================
# Estas son las nuevas variables para Circuit Breaker

# Número de fallos consecutivos antes de abrir el circuito
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Tiempo de espera antes de intentar cerrar el circuito (en segundos)
CIRCUIT_BREAKER_TIMEOUT=30

# Número de peticiones exitosas en HALF_OPEN antes de cerrar el circuito
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# Timeout para peticiones a servicios externos (en segundos)
CIRCUIT_BREAKER_REQUEST_TIMEOUT=10

# ===========================================
# LOGGING Y DEBUGGING
# ===========================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Modo debug (True/False)
DEBUG=True

# Formato de logs: json, text
LOG_FORMAT=text

# Mostrar queries SQL en logs (solo para desarrollo)
SQL_ECHO=False

# ===========================================
# APLICACIÓN
# ===========================================
APP_NAME=Medical Appointment Platform
APP_VERSION=2.0.0
ENVIRONMENT=development

# ===========================================
# WEBSOCKET - Para dashboards en tiempo real
# ===========================================
WEBSOCKET_UPDATE_INTERVAL=2

# ===========================================
# MÉTRICAS Y MONITOREO
# ===========================================
ENABLE_METRICS=True
METRICS_PORT=9090

# ===========================================
# TIMEOUTS Y LÍMITES
# ===========================================
DB_CONNECTION_TIMEOUT=30
DB_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT=3000

# ===========================================
# DESARROLLO
# ===========================================
HOT_RELOAD=True

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
#
# 1. MODO AUTOMÁTICO:
#    - El .env root ya está configurado con DEPLOYMENT_MODE=auto
#    - La IP se detecta automáticamente
#    - NO necesitas configurar manualmente ninguna IP
#
# 2. NOTIFICACIONES (OPCIONAL):
#    - SendGrid: Solo si quieres emails de notificaciones
#    - Twilio: Solo si quieres SMS (muy opcional)
#    - El sistema funciona perfectamente SIN estas configuraciones
#    - Las notificaciones se verán en logs si no configuras SendGrid
#
# 3. SERVICE REGISTRY:
#    - Health checks cada 30 segundos
#    - Heartbeats cada 10 segundos
#    - 3 fallos → servicio DOWN
#
# 4. CIRCUIT BREAKER:
#    - 5 fallos → circuito OPEN
#    - 30 segundos de timeout
#    - 3 éxitos en HALF_OPEN → CLOSED
#
# 5. VALORES POR DEFECTO:
#    - Todos los valores están optimizados para la demo
#    - NO necesitas cambiar nada para que funcione
#    - Solo configura SendGrid si quieres notificaciones por email
#
# ===========================================